{# Links panel in an entry's sidebar (LinkChecker::sidebarHtml(), settings → panel): the problems of the page as it's edited.
   Collapsible; the state is remembered in the browser (web/assets/cp/dist/panel.js). #}
<fieldset id="lc-panel" class="lc-panel" data-site-id="{{ entry.siteId }}">
    <legend class="h6 lc-panel__legend">
        <button type="button" class="lc-panel__toggle" aria-expanded="true" aria-controls="lc-panel-body">
            <span class="lc-panel__chevron" aria-hidden="true"></span>
            <span>{{ 'Links'|t('link-checker') }}</span>
            <span class="lc-panel__summary" data-panel-summary></span>
        </button>
    </legend>
    <div id="lc-panel-body" class="meta lc-panel__body">
        {% include 'link-checker/_panel/list' %}
    </div>
</fieldset>
<script>
    {# Collapse before the page paints, so a collapsed panel doesn't flash open #}
    try {
        if (localStorage.getItem('linkChecker.panel.collapsed') === '1') {
            const panel = document.getElementById('lc-panel');
            panel.classList.add('is-collapsed');
            panel.querySelector('.lc-panel__toggle').setAttribute('aria-expanded', 'false');
        }
    } catch (e) {}
</script>
