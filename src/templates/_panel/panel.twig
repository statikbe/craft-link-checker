{# Links panel in an entry's sidebar (LinkChecker::sidebarHtml(), settings → panel): the problems of the page as it's edited.
   The list is loaded after the page (web/assets/cp/dist/panel.js), so the panel never slows the edit page down.
   Collapsible; the state is remembered in the browser. The ids are unique, so a panel in a slideout works next to the one of
   the page. A slideout namespaces the ids, so the script finds it by data-lc-panel. #}
{% set panelId = 'lc-panel-' ~ entry.id ~ '-' ~ random() %}
<fieldset id="{{ panelId }}" class="lc-panel" data-lc-panel="{{ panelId }}" data-element-id="{{ entry.id }}" data-site-id="{{ entry.siteId }}">
    <legend class="h6 lc-panel__legend">
        <button type="button" class="lc-panel__toggle" aria-expanded="true" aria-controls="{{ panelId }}-body">
            <span class="lc-panel__chevron" aria-hidden="true"></span>
            <span>{{ 'Links'|t('link-checker') }}</span>
            <span class="lc-panel__summary" data-panel-summary></span>
        </button>
    </legend>
    <div id="{{ panelId }}-body" class="meta lc-panel__body">
        <p class="lc-panel__loading light">{{ 'Checking the links…'|t('link-checker') }}</p>
    </div>
</fieldset>
<script>
    {# Collapse before the page paints, so a collapsed panel doesn't flash open; then set it up (now, or once panel.js is loaded) #}
    (function(id) {
        try {
            if (localStorage.getItem('linkChecker.panel.collapsed') === '1') {
                const panel = document.querySelector('[data-lc-panel="' + id + '"]');
                panel.classList.add('is-collapsed');
                panel.querySelector('.lc-panel__toggle').setAttribute('aria-expanded', 'false');
            }
        } catch (e) {}
        if (window.LinkCheckerPanel) {
            window.LinkCheckerPanel.init(id);
        } else {
            (window.LinkCheckerPanels = window.LinkCheckerPanels || []).push(id);
        }
    })({{ panelId|json_encode|raw }});
</script>
