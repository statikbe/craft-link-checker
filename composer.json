{
  "name": "statikbe/craft-link-checker",
  "description": "Finds broken links in the content of Craft CMS entries (links to deleted, disabled or expired entries, deleted assets, own-site URLs that no longer exist) and lists the pages that contain them in a dashboard widget",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "links",
    "broken-links",
    "link-checker",
    "seo",
    "content-quality"
  ],
  "support": {
    "docs": "https://github.com/statikbe/craft-link-checker/blob/main/README.md",
    "issues": "https://github.com/statikbe/craft-link-checker/issues"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Statik",
      "homepage": "https://www.statik.be"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.6.0"
  },
  "suggest": {
    "verbb/hyper": "Hyper link fields are checked too"
  },
  "autoload": {
    "psr-4": {
      "statikbe\\linkchecker\\": "src/"
    }
  },
  "extra": {
    "name": "Link Checker",
    "handle": "link-checker",
    "developer": "Statik",
    "developerUrl": "https://www.statik.be",
    "documentationUrl": "https://github.com/statikbe/craft-link-checker/blob/main/README.md",
    "class": "statikbe\\linkchecker\\LinkChecker"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.0",
    "craftcms/ckeditor": "^4.0"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest",
    "ci": [
      "@check-cs",
      "@phpstan",
      "@test"
    ]
  }
}
